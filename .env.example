VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required for local admin login, reviews, and CMS.
# On Vercel/hosting, add the same two variables (Production + Preview) and redeploy.
# The anon/publishable key is safe in the browser; RLS protects your tables.

# Server-only (never prefix with VITE_). Used by contact form + admin messaging.
# All mail is sent from and delivered to info@starlightvisualstudio.de.
RESEND_API_KEY=re_xxxxxxxx

# Public site origin used for email logo/assets and CTAs (no trailing slash).
# Example: https://starlightvisualstudio.de or https://starlightsvisuals.vercel.app
SITE_URL=https://starlightsvisuals.vercel.app
